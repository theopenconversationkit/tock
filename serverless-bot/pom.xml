    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-no-vertx-no-mongo</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>io.vertx:*:*:*:compile</exclude>
                                        <exclude>io.vertx:*:*:*:runtime</exclude>
                                        <exclude>io.netty:*:*:*:compile</exclude>
                                        <exclude>io.netty:*:*:*:runtime</exclude>
                                        <exclude>org.mongodb</exclude>
                                        <exclude>ai.tock:tock-shared:*:jar:compile</exclude>
                                        <exclude>ai.tock:tock-shared:*:jar:runtime</exclude>
                                        <exclude>ai.tock:tock-bot-engine:*:jar:compile</exclude>
                                        <exclude>ai.tock:tock-bot-engine:*:jar:runtime</exclude>
                                        <exclude>ai.tock:tock-bot-storage-mongo</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
