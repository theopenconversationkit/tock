<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.tock</groupId>
        <artifactId>tock-bot</artifactId>
        <version>26.9.2-SNAPSHOT</version>
    </parent>

    <artifactId>tock-bot-storage-model</artifactId>
    <name>Tock Bot Storage Model</name>
    <description>The documents the bot storages persist (user timelines, dialogs...), shared by the MongoDB and the DynamoDB storages</description>

    <dependencies>
        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>tock-bot-engine-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.litote.kmongo</groupId>
            <artifactId>kmongo-dsl-data</artifactId>
        </dependency>
        <dependency>
            <groupId>org.litote.kmongo</groupId>
            <artifactId>kmongo-dsl-jackson-data</artifactId>
        </dependency>
        <dependency>
            <groupId>org.litote.kmongo</groupId>
            <artifactId>kmongo-dsl-id</artifactId>
        </dependency>
        <dependency>
            <groupId>org.litote.kmongo</groupId>
            <artifactId>kmongo-dsl-id-jackson</artifactId>
        </dependency>

        <!-- the query DSL generated by @Data: only the MongoDB storage loads it -->
        <dependency>
            <groupId>org.litote.kmongo</groupId>
            <artifactId>kmongo-dsl-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- the public signatures of tock-bot-engine-core that expose Vert.x types -->
        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>tock-shared</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-web</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-lang-kotlin-coroutines</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>tock-shared-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/kotlin</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin}</version>

                <executions>
                    <execution>
                        <id>kapt</id>
                        <goals>
                            <goal>kapt</goal>
                        </goals>
                        <configuration>
<!--                            <sourceDirs>-->
<!--                                <sourceDir>${project.build.directory}/generated-source/kapt</sourceDir>-->
<!--                            </sourceDirs>-->
                            <annotationProcessorPaths>
                                <annotationProcessorPath>
                                    <groupId>org.litote.kmongo</groupId>
                                    <artifactId>kmongo-dsl-annotation-generator</artifactId>
                                    <version>${kmongo-dsl}</version>
                                </annotationProcessorPath>
                                <annotationProcessorPath>
                                    <groupId>org.litote.kmongo</groupId>
                                    <artifactId>kmongo-dsl-annotation-processor</artifactId>
                                    <version>${kmongo-dsl}</version>
                                </annotationProcessorPath>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>

                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <args>
                                <arg>-opt-in=ai.tock.shared.InternalTockApi</arg>
                            </args>
                        </configuration>
                    </execution>

                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                        <configuration>
                            <args>
                                <arg>-opt-in=ai.tock.shared.InternalTockApi</arg>
                            </args>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
