<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.tock</groupId>
        <artifactId>tock-bot</artifactId>
        <version>26.9.2-SNAPSHOT</version>
    </parent>

    <artifactId>tock-bot-engine-core</artifactId>
    <name>Tock Bot Engine Core</name>
    <description>Core framework for building bots, without the Vert.x server: tock-bot-engine adds it</description>

    <dependencies>
        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>tock-shared-core</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>tock-gen-ai-orchestrator-client</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>ai.tock</groupId>
                    <artifactId>tock-shared</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>nlp-api-client</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>ai.tock</groupId>
                    <artifactId>tock-shared</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>tock-translator-core</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>ai.tock</groupId>
                    <artifactId>tock-shared</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>tock-stt-core</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>ai.tock</groupId>
                    <artifactId>tock-shared</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Kept for the public signatures that expose Vert.x types (ConnectorController.registerServices,
             BotRepository.healthcheckHandler, ConnectorProvider.createRequestFilter...): tock-bot-engine brings them
             at runtime. BytecodeDependenciesTest checks that no other class references them. -->
        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>tock-shared</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-web</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-codegen-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-lang-kotlin-coroutines</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>tock-shared</artifactId>
            <type>test-jar</type>
        </dependency>
        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>tock-shared-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.mockk</groupId>
            <artifactId>mockk-jvm</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jasypt</groupId>
            <artifactId>jasypt</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- workaround for mockk issue see https://github.com/mockk/mockk/issues/199 -->
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-codegen</artifactId>
            <version>${vertx}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/kotlin</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>compile</id>
                        <configuration>
                            <args>
                                <arg>-opt-in=ai.tock.shared.InternalTockApi</arg>
                            </args>
                        </configuration>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <configuration>
                            <args>
                                <arg>-opt-in=ai.tock.shared.InternalTockApi</arg>
                            </args>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- Vert.x and MongoDB are allowed at compile time only (provided), never at runtime -->
                        <id>enforce-no-vertx-no-mongo-at-runtime</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>io.vertx:*:*:*:compile</exclude>
                                        <exclude>io.vertx:*:*:*:runtime</exclude>
                                        <exclude>io.netty:*:*:*:compile</exclude>
                                        <exclude>io.netty:*:*:*:runtime</exclude>
                                        <exclude>org.mongodb:*:*:*:compile</exclude>
                                        <exclude>org.mongodb:*:*:*:runtime</exclude>
                                        <exclude>ai.tock:tock-shared:*:jar:compile</exclude>
                                        <exclude>ai.tock:tock-shared:*:jar:runtime</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
