    <modelVersion>4.0.0</modelVersion>

    <!--
      Bill of materials of Tock: the Tock artifacts and the versions of their third-party dependencies.
      It is also the parent of tock-root, so it is the single place where dependency versions are defined.

      Projects using Tock should import it to get a consistent classpath (Maven does not apply the
      dependencyManagement of a dependency's parent to the projects that use this dependency):

        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>tock-bom</artifactId>
            <version>${tock.version}</version>
            <type>pom</type>
            <scope>import</scope>
        </dependency>

      Only the dependencyManagement section is imported: no dependency, plugin or property leaks to importers.
    -->
