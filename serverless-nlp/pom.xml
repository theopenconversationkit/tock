<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.tock</groupId>
        <artifactId>tock-root</artifactId>
        <version>26.9.2-SNAPSHOT</version>
    </parent>

    <artifactId>tock-serverless-nlp</artifactId>
    <name>Tock Serverless NLP</name>
    <description>Runs the NLP API in a serverless process (Cloud Run, AWS Lambda): no Vert.x, no MongoDB</description>

        <dependencies>
        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>tock-serverless-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>tock-nlp-api-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- the NLP core and the model service, without tock-shared (they only use tock-shared-core) -->
        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>tock-nlp-core-service</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>ai.tock</groupId>
                    <artifactId>tock-shared</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>tock-nlp-model-service</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>ai.tock</groupId>
                    <artifactId>tock-shared</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- initEncryptor, as NlpVerticle: jasypt is provided in tock-shared-core -->
        <dependency>
            <groupId>org.jasypt</groupId>
            <artifactId>jasypt</artifactId>
        </dependency>

        <!-- the server types of the bot runtime signatures: compile time only, as in tock-serverless-runtime -->
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-web</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-lang-kotlin-coroutines</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- the end to end test: the NLP engine and the DynamoDB storage, without tock-shared -->
        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>tock-nlp-model-opennlp</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>ai.tock</groupId>
                    <artifactId>tock-shared</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>tock-nlp-duckling-client</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>ai.tock</groupId>
                    <artifactId>tock-shared</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.vertx</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>tock-nlp-front-storage-dynamodb</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.mockk</groupId>
            <artifactId>mockk-jvm</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>compile</id>
                        <configuration>
                            <args>
                                <arg>-opt-in=ai.tock.shared.InternalTockApi</arg>
                            </args>
                        </configuration>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <configuration>
                            <args>
                                <arg>-opt-in=ai.tock.shared.InternalTockApi</arg>
                            </args>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- the provided Vert.x is on the test classpath by default: the tests prove the runtime works without it -->
                    <classpathDependencyExcludes>
                        <classpathDependencyExclude>io.vertx:*</classpathDependencyExclude>
                        <classpathDependencyExclude>io.netty:*</classpathDependencyExclude>
                    </classpathDependencyExcludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-no-vertx-no-mongo</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>io.vertx:*:*:*:compile</exclude>
                                        <exclude>io.vertx:*:*:*:runtime</exclude>
                                        <exclude>io.vertx:*:*:*:test</exclude>
                                        <exclude>io.netty:*:*:*:compile</exclude>
                                        <exclude>io.netty:*:*:*:runtime</exclude>
                                        <exclude>io.netty:*:*:*:test</exclude>
                                        <exclude>org.mongodb</exclude>
                                        <exclude>ai.tock:tock-shared</exclude>
                                        <exclude>ai.tock:tock-bot-engine</exclude>
                                        <exclude>ai.tock:tock-nlp-front-storage-mongo</exclude>
                                        <exclude>ai.tock:tock-nlp-model-storage-mongo</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
