"""
Checks that the Tock jars of a serverless starter (tock-serverless-bot by default) only reference classes of its
classpath, which has neither Vert.x, Netty, MongoDB nor tock-shared.

The classes kept for the Vert.x servers (the Router methods of the connectors, RequestFilter...) are listed in
ALLOWED: the serverless runtime never calls them, and the JVM resolves a reference only when it runs.

The Tock jars are taken from the target directories of this tree, not from the local Maven repository: the
worktrees share it at the same version, and another branch may have installed older jars.

Run after `mvn package` of the modules of the starter.

Usage: scripts/serverless-deps [--module serverless-bot] [--offline]
"""

import argparse
import re
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

# (class of the jar, missing class): regular expressions
ALLOWED = [
    # the Vert.x server of the bots, kept in the core for the signatures of the public API
    (r"ai\.tock\.bot\.engine\.(BotRepository|BotServer|ConnectorController|TockConnectorController|VertxHealthchecks|WebSocketController)\b.*", r"(io\.vertx|ai\.tock\.shared\.vertx)\..*"),
    (r"ai\.tock\.bot\.engine\.config\.UploadedFilesService\b.*", r"(io\.vertx|ai\.tock\.shared\.vertx)\..*"),
    (r"ai\.tock\.serverless\.ServerlessBotServer\b.*", r"io\.vertx\..*"),
    # ConnectorProvider.createRequestFilter: called by the Vert.x connectors only
    (r"ai\.tock\.bot\.connector\..*", r"ai\.tock\.shared\.security\.RequestFilter(Kt)?"),
    # the classes the connectors keep for their Vert.x routes (a security handler of the project, a Vert.x request
    # filter...) and their former constructors: the same exceptions as their bytecode tests
    (r"ai\.tock\.bot\.connector\..*\.(\w*VertxServices|Vertx\w*Responder|\w*AuthorisationHandler)(\$.*)?", r".*"),
    (r"ai\.tock\.bot\.connector\..*Security\$Vertx", r".*"),
    (r"ai\.tock\.bot\.connector\.alcmeon\.AlcmeonConnector(Callback)?(\$.*)?", r"io\.vertx\..*"),
    (r"ai\.tock\.bot\.connector\.iadvize\.(IadvizeConnectorCallback|IadvizeSecurity|CustomRequest|model\.request\.RequestIds)(\$.*)?", r"(io\.vertx|ai\.tock\.shared\.exception)\..*"),
    (r"ai\.tock\.bot\.connector\.openai\.OpenAIConnectorCallback", r"io\.vertx\..*"),
    (r"ai\.tock\.bot\.connector\.web\.(WebRequestInfos|WebOrchestration)(\$.*)?", r"io\.vertx\..*"),
    # the orchestration of bots runs on Vert.x and MongoDB: it is not supported by the serverless runtime
    (r"ai\.tock\.bot\.orchestration\..*", r".*"),
    # the MongoDB DAOs replaced by the DynamoDB ones, and the BSON annotations (ignored when missing)
    (r"ai\.tock\.bot\.connector\.whatsapp\.cloud\.database\..*", r"(com\.mongodb|org\.litote\.kmongo|org\.bson)\..*"),
    # frontModule (and its TockUserListener of the admin): the serverless NLP binds its own modules
    (r"ai\.tock\.nlp\.front\.service\.(AdminTockUserListener|FrontIocKt)\b.*", r"ai\.tock\.shared\.security\.TockUser(Listener)?"),
    # the query DSL generated by KMongo (X_, X_Col, X_Map): only the MongoDB storages load it
    (r"ai\.tock\..*_(Col|Map)?(\$.*)?", r"org\.litote\.kmongo\.property\..*"),
    # optional dependencies of tock-shared-core, used only when present
    (r"ai\.tock\.shared\.Dice\b.*", r"org\.bson\.types\.ObjectId"),
    (r"ai\.tock\.shared\.RetrofitsKt\b.*", r"io\.github\.resilience4j\..*"),
]


def run(command, cwd=ROOT):
    return subprocess.run(command, cwd=cwd, check=True, capture_output=True, text=True).stdout


def reactor_jars():
    """The jars built in this tree, by artifactId."""
    jars = {}
    for jar in ROOT.glob("**/target/*.jar"):
        name = jar.name
        if any(name.endswith(suffix) for suffix in ("-sources.jar", "-tests.jar", "-javadoc.jar")):
            continue
        match = re.match(r"(.+?)-\d.*\.jar$", name)
        if match:
            jars[match.group(1)] = jar
    return jars


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--module", default="serverless-bot")
    parser.add_argument("--offline", action="store_true", help="run Maven offline")
    args = parser.parse_args()

    with tempfile.NamedTemporaryFile("r", suffix=".txt") as output:
        run(["mvn", "-q", *(["-o"] if args.offline else []), "dependency:build-classpath", "-pl", args.module, f"-Dmdep.outputFile={output.name}"])
        classpath = output.read().strip().split(":")

    built = reactor_jars()
    resolved = []
    tock_jars = []
    for entry in classpath:
        path = Path(entry)
        match = re.match(r"(.+?)-\d.*\.jar$", path.name)
        if "/ai/tock/" in entry and match:
            jar = built.get(match.group(1))
            if jar is None:
                sys.exit(f"{path.name} is not built in this tree: run mvn package first")
            resolved.append(str(jar))
            tock_jars.append(jar)
        else:
            resolved.append(entry)

    joined = ":".join(resolved)
    violations = []
    for jar in tock_jars:
        report = subprocess.run(
            ["jdeps", "--multi-release", "21", "-cp", joined, "--missing-deps", str(jar)],
            capture_output=True,
            text=True,
        ).stdout
        for line in report.splitlines():
            parts = line.split()
            # the summary line of the jar ("x.jar -> not found") is not a reference
            if len(parts) >= 4 and parts[1] == "->" and parts[-2:] == ["not", "found"] and not parts[0].endswith(".jar"):
                source, missing = parts[0], parts[2]
                if not any(re.fullmatch(s, source) and re.fullmatch(m, missing) for s, m in ALLOWED):
                    violations.append(f"{jar.name}: {source} -> {missing}")

    # jdeps does not see everything: a lambda compiled with invokedynamic loads the classes of its signature when
    # its class is initialized. The connectors, their providers and their callbacks are initialized for real.
    names = []
    for jar in tock_jars:
        if "connector" not in jar.name:
            continue
        for entry in subprocess.run(["jar", "tf", str(jar)], capture_output=True, text=True).stdout.splitlines():
            simple = entry.rsplit("/", 1)[-1]
            if entry.endswith(".class") and "$" not in simple and re.search(r"(Connector|ConnectorProvider|Callback)\.class$", simple):
                names.append(entry[: -len(".class")].replace("/", "."))
    loader = ROOT / "scripts" / "serverless-deps-loader" / "LoadClasses.java"
    loaded = subprocess.run(["java", "-cp", joined, str(loader)], input="\n".join(names), capture_output=True, text=True)
    violations += [f"initialization: {line[len('MISSING '):]}" for line in loaded.stdout.splitlines() if line.startswith("MISSING ")]

    if violations:
        print("\n".join(sorted(set(violations))[:200]))
        sys.exit(f"{len(set(violations))} references to classes missing from the classpath of {args.module}")
    print(f"{len(tock_jars)} Tock jars of {args.module}: no reference to a missing class, {len(names)} connector classes initialized")


if __name__ == "__main__":
    main()
