"""
Checks that the current tree does not break the projects built on a baseline commit.

Two checks, both against the jars built from the baseline commit (the merge base with
origin/master by default):

1. Binary API: japicmp compares the union of all the published jars, old against new. Comparing
   the union rather than module by module lets a class move from one artifact to another one it
   depends on (tock-shared -> tock-shared-core) without being reported as removed: what matters
   to a project is the fully qualified name on its classpath.
2. Runtime classpath: for each module of the baseline, the runtime dependencies (groupId:artifactId)
   must still be there. This is what guarantees that the moved classes still reach the projects.

Declarations annotated with @InternalTockApi, and the anonymous classes generated by the Kotlin
compiler (names ending with $<digit>), are not part of the API.

Usage: scripts/api-compat [--baseline <git ref>] [--baseline-dir <dir>] [--skip-current-build]
"""

import argparse
import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.request
import zipfile
import xml.etree.ElementTree as ET
from pathlib import Path

JAPICMP_VERSION = "0.27.0"
JAPICMP_URL = (
    "https://repo1.maven.org/maven2/com/github/siom79/japicmp/japicmp/"
    f"{JAPICMP_VERSION}/japicmp-{JAPICMP_VERSION}-jar-with-dependencies.jar"
)
EXCLUDES = ["@ai.tock.shared.InternalTockApi"] + [f"*$*{d}" for d in range(10)]
DEPS_FILE = "target/api-compat-deps.txt"
POM_NS = {"m": "http://maven.apache.org/POM/4.0.0"}
# modules that are not published as libraries
IGNORED_DIRS = {"node_modules", "target", ".git"}

ROOT = Path(__file__).resolve().parent.parent


def run(cmd, cwd):
    print(f"$ {' '.join(cmd)}  (in {cwd})", flush=True)
    subprocess.run(cmd, cwd=cwd, check=True)


def build(tree: Path):
    """Packages every module and writes its runtime dependencies to target/api-compat-deps.txt."""
    run(
        [
            "mvn", "-B", "-ntp", "-q", "package", "dependency:list",
            "-DskipTests", "-Dskip.npm", "-Dexec.skip",
            "-DincludeScope=runtime", "-DoutputAbsoluteArtifactFilename=true",
            f"-DoutputFile={DEPS_FILE}", "-DappendOutput=false",
        ],
        tree,
    )


def modules(tree: Path):
    """Yields (artifactId, module dir) for every jar module of the tree."""
    for pom in sorted(tree.rglob("pom.xml")):
        if IGNORED_DIRS.intersection(pom.relative_to(tree).parts):
            continue
        project = ET.parse(pom).getroot()
        packaging = project.findtext("m:packaging", "jar", POM_NS)
        if packaging != "jar":
            continue
        yield project.findtext("m:artifactId", namespaces=POM_NS), pom.parent


def module_jar(module_dir: Path, artifact_id: str):
    jars = [
        j for j in (module_dir / "target").glob(f"{artifact_id}-*.jar")
        if not re.search(r"-(sources|tests|test-sources|javadoc|jar-with-dependencies|fat|shaded)\.jar$", j.name)
    ]
    return jars[0] if len(jars) == 1 else None


def runtime_deps(module_dir: Path):
    """Returns {groupId:artifactId -> jar path} from the dependency:list output of the module."""
    deps = {}
    f = module_dir / DEPS_FILE
    if not f.exists():
        return deps
    for line in f.read_text().splitlines():
        parts = line.strip().split(" -- ")[0].split(":")
        # group:artifact:type[:classifier]:version:scope:path
        if len(parts) >= 6 and parts[-2] in ("compile", "runtime"):
            deps[f"{parts[0]}:{parts[1]}"] = parts[-1]
    return deps


def collect(tree: Path):
    jars, deps = {}, {}
    for artifact_id, module_dir in modules(tree):
        jar = module_jar(module_dir, artifact_id)
        if jar:
            jars[artifact_id] = jar
            deps[artifact_id] = runtime_deps(module_dir)
    return jars, deps


def japicmp_jar(cache: Path):
    jar = cache / f"japicmp-{JAPICMP_VERSION}.jar"
    if not jar.exists():
        cache.mkdir(parents=True, exist_ok=True)
        urllib.request.urlretrieve(JAPICMP_URL, jar)
    return jar


def classpath(deps, own_jars):
    paths = {p for module_deps in deps.values() for p in module_deps.values() if p.endswith(".jar")}
    own = {str(j) for j in own_jars}
    return os.pathsep.join(sorted(p for p in paths if p not in own and Path(p).exists()))


def jar_classes(jars):
    """Fully qualified names of the classes of the jars."""
    names = set()
    for jar in jars:
        with zipfile.ZipFile(jar) as z:
            names.update(
                n[: -len(".class")].replace("/", ".")
                for n in z.namelist()
                if n.endswith(".class") and not n.startswith("META-INF/")
            )
    return names


def still_inherits(class_name, parent, jars):
    """True when class_name still extends or implements parent in the jars."""
    out = subprocess.run(
        ["javap", "-cp", os.pathsep.join(str(j) for j in jars), class_name], capture_output=True, text=True
    ).stdout
    declaration = next((line for line in out.splitlines() if f" {class_name.split('.')[-1]}" in line or class_name in line), "")
    return parent in declaration


def internal_api(class_name, jars):
    """True when the class, or one of its enclosing classes, is annotated with @InternalTockApi."""
    cp = os.pathsep.join(str(j) for j in jars)
    parts = class_name.split("$")
    for i in range(len(parts), 0, -1):
        out = subprocess.run(["javap", "-v", "-cp", cp, "$".join(parts[:i])], capture_output=True, text=True).stdout
        if "Lai/tock/shared/InternalTockApi;" in out:
            return True
    return False


def incompatibilities(xml_report: Path, new_jars):
    """
    Reads the japicmp XML report and returns the binary incompatibilities that matter for a project.

    japicmp does not know the Kotlin visibilities, hence the two filters:
    - a member whose JVM name contains $ is internal (name mangled with the module name, which changes
      when the declaration moves to another module) or synthetic;
    - a class reported as removed while it is still in the new jars, annotated with @InternalTockApi, or a
      supertype reported as removed while the class still inherits it, is only excluded by @InternalTockApi
      in the new version: it used to be internal, so no project can use it.
    """
    new_classes = jar_classes(new_jars)
    found = []
    for c in ET.parse(xml_report).getroot().iter("class"):
        if c.get("binaryCompatible") != "false":
            continue
        name = c.get("fullyQualifiedName")
        if c.get("changeStatus") == "REMOVED" and name in new_classes and internal_api(name, new_jars):
            continue
        for element in c.iter():
            if element is c:
                continue
            changes = [
                ch.get("type") for ch in element.findall("compatibilityChanges/compatibilityChange")
                if ch.get("binaryCompatible") == "false"
            ]
            if not changes:
                continue
            if element.tag in ("method", "field") and "$" in (element.get("name") or ""):
                continue
            if element.tag in ("interface", "superclass"):
                parent = element.get("fullyQualifiedName") or element.get("superclassOld") or ""
                if parent in new_classes and still_inherits(name, parent, new_jars):
                    continue
            if element.tag == "compatibilityChanges":
                # class level changes, e.g. CLASS_REMOVED
                changes = [ch.get("type") for ch in element if ch.get("binaryCompatible") == "false"]
                if not changes:
                    continue
            found.append(f"{name} {element.tag} {element.get('name') or element.get('fullyQualifiedName') or ''}: {', '.join(changes)}")
    return sorted(set(found))


def check_api(old, new, report_dir: Path):
    old_jars, old_deps = old
    new_jars, new_deps = new
    report_dir.mkdir(parents=True, exist_ok=True)
    xml_report = report_dir / "api-compat.xml"
    cmd = [
        "java", "-jar", str(japicmp_jar(ROOT / "target" / "api-compat")),
        "--old", ";".join(str(j) for j in old_jars.values()),
        "--new", ";".join(str(j) for j in new_jars.values()),
        "--old-classpath", classpath(old_deps, old_jars.values()),
        "--new-classpath", classpath(new_deps, new_jars.values()),
        "--exclude", ";".join(EXCLUDES),
        "--only-incompatible", "--ignore-missing-classes",
        "--html-file", str(report_dir / "api-compat.html"),
        "--xml-file", str(xml_report),
    ]
    print(f"$ java -jar japicmp ({len(old_jars)} old jars, {len(new_jars)} new jars)", flush=True)
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        print(result.stderr[-5000:], file=sys.stderr)
        raise SystemExit(f"japicmp failed with exit code {result.returncode}")
    found = incompatibilities(xml_report, list(new_jars.values()))
    if found:
        print(f"Binary API: {len(found)} incompatible changes (report: {report_dir / 'api-compat.html'})")
        for f in found:
            print(f"  {f}")
        return False
    print("Binary API: no incompatible change")
    return True


def check_deps(old, new):
    _, old_deps = old
    new_jars, new_deps = new
    ok = True
    for artifact_id, deps in sorted(old_deps.items()):
        if artifact_id not in new_jars:
            print(f"Runtime classpath: module {artifact_id} no longer exists")
            ok = False
            continue
        missing = sorted(set(deps) - set(new_deps.get(artifact_id, {})))
        if missing:
            print(f"Runtime classpath: {artifact_id} lost {', '.join(missing)}")
            ok = False
    if ok:
        print(f"Runtime classpath: the {len(old_deps)} baseline modules keep all their runtime dependencies")
    return ok


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--baseline", help="git ref of the baseline (default: merge base with origin/master)")
    parser.add_argument("--skip-current-build", action="store_true", help="reuse the jars already built in the tree")
    parser.add_argument(
        "--baseline-dir",
        help="keep the built baseline in this directory, and reuse it if it already exists",
    )
    args = parser.parse_args()

    baseline = args.baseline or subprocess.check_output(
        ["git", "merge-base", "HEAD", "origin/master"], cwd=ROOT, text=True
    ).strip()
    keep = args.baseline_dir is not None
    if keep and Path(args.baseline_dir).exists():
        baseline_dir, reuse = Path(args.baseline_dir).resolve(), True
        print(f"Reusing the baseline built in {baseline_dir}")
    else:
        baseline_dir, reuse = (Path(args.baseline_dir).resolve() if keep else Path(tempfile.mkdtemp(prefix="tock-api-baseline-"))), False
        shutil.rmtree(baseline_dir, ignore_errors=True)
        run(["git", "worktree", "add", "--detach", str(baseline_dir), baseline], ROOT)
    try:
        if not reuse:
            build(baseline_dir)
        old = collect(baseline_dir)
        if not args.skip_current_build:
            build(ROOT)
        new = collect(ROOT)
        api_ok = check_api(old, new, ROOT / "target" / "api-compat")
        deps_ok = check_deps(old, new)
    finally:
        if not keep:
            run(["git", "worktree", "remove", "--force", str(baseline_dir)], ROOT)
    sys.exit(0 if api_ok and deps_ok else 1)


if __name__ == "__main__":
    main()
