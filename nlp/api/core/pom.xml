<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- not tock-nlp-api: its dependencies bring tock-shared -->
    <parent>
        <groupId>ai.tock</groupId>
        <artifactId>tock-nlp</artifactId>
        <version>26.9.2-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>tock-nlp-api-core</artifactId>
    <name>Tock NLP API Core</name>
    <description>The runtime routes of the NLP API, without the Vert.x server: tock-nlp-api-service keeps its own</description>

    <dependencies>
        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>tock-shared-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>tock-nlp-front-client</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>ai.tock</groupId>
                    <artifactId>tock-shared</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>tock-nlp-front-service</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>ai.tock</groupId>
                    <artifactId>tock-shared</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>tock-shared</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>tock-shared-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.mockk</groupId>
            <artifactId>mockk-jvm</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>compile</id>
                        <configuration>
                            <args>
                                <arg>-opt-in=ai.tock.shared.InternalTockApi</arg>
                            </args>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- the NLP API of the serverless runtime: no Vert.x, no MongoDB driver, no tock-shared -->
                        <id>enforce-no-vertx-no-mongo-at-runtime</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>io.vertx:*:*:*:compile</exclude>
                                        <exclude>io.vertx:*:*:*:runtime</exclude>
                                        <exclude>io.netty:*:*:*:compile</exclude>
                                        <exclude>io.netty:*:*:*:runtime</exclude>
                                        <exclude>org.mongodb:*:*:*:compile</exclude>
                                        <exclude>org.mongodb:*:*:*:runtime</exclude>
                                        <exclude>ai.tock:tock-shared:*:jar:compile</exclude>
                                        <exclude>ai.tock:tock-shared:*:jar:runtime</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
