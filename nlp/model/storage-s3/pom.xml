<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.tock</groupId>
        <artifactId>tock-nlp-model</artifactId>
        <version>26.9.2-SNAPSHOT</version>
    </parent>

    <artifactId>tock-nlp-model-storage-s3</artifactId>
    <name>Tock NLP Model S3</name>
    <description>S3 storage of the NLP model files (AWS S3 or any S3 compatible storage)</description>

    <dependencies>
        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>tock-nlp-model-service</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>ai.tock</groupId>
                    <artifactId>tock-shared</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- S3Bucket uses only tock-shared-core: the storage works without Vert.x nor MongoDB -->
        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>tock-aws-tools</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>ai.tock</groupId>
                    <artifactId>tock-shared</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>tock-shared-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test-junit5</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>io.mockk</groupId>
            <artifactId>mockk-jvm</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- sharedTestModule -->
        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>tock-shared</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ai.tock</groupId>
            <artifactId>tock-shared</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/kotlin</sourceDirectory>
        <testSourceDirectory>src/test/kotlin</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-no-mongo-no-vertx</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.mongodb</exclude>
                                        <exclude>io.vertx:*:*:*:compile</exclude>
                                        <exclude>io.vertx:*:*:*:runtime</exclude>
                                        <exclude>io.netty:*:*:*:compile</exclude>
                                        <exclude>io.netty:*:*:*:runtime</exclude>
                                        <exclude>ai.tock:tock-shared:*:jar:compile</exclude>
                                        <exclude>ai.tock:tock-shared:*:jar:runtime</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
